---
import config from "$config";
import App from "$layouts/App.astro";
import Header from "$layouts/header/Header.astro";
import Footer from "$layouts/Footer.astro";
import "$styles/tailwind.css";
import "$styles/global.css";
import "$styles/markdown.css";
import "medium-zoom/dist/style.css";
import "katex/dist/katex.min.css";

const { locale = config.i18n.defaultLocale, title: subtitle, description = config.description, article } = Astro.props;
const title = config.title;
---

<script>
	import Time from "$utils/time";
	import MediumnZoom, { type Zoom } from "medium-zoom/dist/pure";

	// Set the `title` attribute of all `<time>` elements to localized date-time strings
	const localizeTimes = () => document.querySelectorAll("time").forEach(time => time.dateTime && (time.title = Time.toLocaleString(time.dateTime, navigator.language, true)));

	// Add zoom effect to images within markdown content
	const zoom: Zoom = MediumnZoom(undefined, { background: "#00000044" });
	window.zoom = () => {
		zoom.detach();
		zoom.attach(".markdown img:not([data-nozoom])");
	};

	// --- Mermaid diagram rendering (lazy-loaded) ---
	type MermaidAPI = typeof import("mermaid").default;
	let mermaidModule: MermaidAPI | null = null;
	let currentTheme: string | null = null;
	let renderVersion = 0;
	let renderQueue = Promise.resolve();
	let themeObserverSetup = false;

	function escapeHtml(source: string) {
		return source.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
	}

	function getMermaidTheme() {
		return document.documentElement.dataset.theme === "dark" ? "dark" : "default";
	}

	function getMermaidSource(diagram: HTMLElement) {
		return diagram.querySelector<HTMLElement>(".mermaid-source")?.textContent ?? "";
	}

	function showMermaidSource(diagram: HTMLElement, source = getMermaidSource(diagram)) {
		diagram.innerHTML = `<pre class="mermaid-source">${escapeHtml(source)}</pre>`;
		delete diagram.dataset.renderedTheme;
	}

	async function renderMermaidNow(version: number) {
		const diagrams = document.querySelectorAll<HTMLElement>(".mermaid-diagram");
		if (!diagrams.length) return;

		try {
			if (!mermaidModule) {
				mermaidModule = (await import("mermaid")).default;
			}
		} catch (err) {
			if (version === renderVersion) {
				diagrams.forEach(diagram => showMermaidSource(diagram));
				console.error("Mermaid load error:", err);
			}
			return;
		}

		if (version !== renderVersion) return;

		const theme = getMermaidTheme();
		if (currentTheme !== theme) {
			mermaidModule.initialize({ startOnLoad: false, theme });
			currentTheme = theme;
		}

		for (const [index, diagram] of diagrams.entries()) {
			if (version !== renderVersion || theme !== getMermaidTheme()) return;
			if (diagram.dataset.renderedTheme === theme) continue;

			const source = getMermaidSource(diagram);
			if (!source) continue;

			try {
				const id = `mermaid-${version}-${index}`;
				const { svg } = await mermaidModule.render(id, source);
				if (version !== renderVersion || theme !== getMermaidTheme()) return;
				diagram.innerHTML = `<pre class="mermaid-source" hidden>${escapeHtml(source)}</pre>${svg}`;
				diagram.dataset.renderedTheme = theme;
			} catch (err) {
				if (version !== renderVersion || theme !== getMermaidTheme()) return;
				showMermaidSource(diagram, source);
				console.error("Mermaid render error:", err);
			}
		}
	}

	function renderMermaid() {
		const version = ++renderVersion;
		renderQueue = renderQueue.then(() => renderMermaidNow(version), () => renderMermaidNow(version)).catch(err => console.error("Mermaid render error:", err));
	}

	function setupThemeObserver() {
		if (themeObserverSetup) return;
		themeObserverSetup = true;
		new MutationObserver(() => renderMermaid()).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["data-theme"]
		});
	}

	// Page initialization function
	function initialize() {
		localizeTimes();
		window.zoom();
		renderMermaid();
		setupThemeObserver();
	}

	// Execute initialization on first load
	initialize();

	// Listen for page load event and re-initialize on page transitions
	document.addEventListener("astro:page-load", initialize);
</script>

<App {locale} {title} {subtitle} {description} {article} author={config.author.name}>
	<div class="flex flex-col mx-auto *:*:px-3 w-[min(100%,1000px)]">
		<!-- Stretch body to full viewport height to prevent layout jumps from toggleable scrollbars. -->
		<div id="body" class="flex flex-col min-h-screen">
			<Header {locale} {title} />

			<slot />
		</div>

		<Footer {locale} author={config.author} copyright={config.copyright} />
	</div>
</App>
