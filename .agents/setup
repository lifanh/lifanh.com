#!/usr/bin/env bash
set -euo pipefail

readonly NODE_VERSION="24.18.0"
case "$(uname -m)" in
  x86_64) readonly NODE_ARCH="x64" ;;
  aarch64|arm64) readonly NODE_ARCH="arm64" ;;
  *)
    echo "Unsupported architecture for Node.js: $(uname -m)" >&2
    exit 1
    ;;
esac

install_node() {
  local archive install_dir temp_dir

  archive="node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz"
  install_dir="/opt/${archive%.tar.xz}"
  temp_dir="$(mktemp -d)"
  trap 'rm -rf -- "$temp_dir"' RETURN

  echo "Installing Node.js v${NODE_VERSION}..."
  curl --fail --location --silent --show-error \
    "https://nodejs.org/dist/v${NODE_VERSION}/${archive}" \
    --output "${temp_dir}/${archive}"
  curl --fail --location --silent --show-error \
    "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" \
    --output "${temp_dir}/SHASUMS256.txt"
  (
    cd "$temp_dir"
    grep "  ${archive}$" SHASUMS256.txt | sha256sum --check --strict -
  )
  sudo rm -rf -- "$install_dir"
  sudo tar --extract --file "${temp_dir}/${archive}" --directory /opt
  for executable in node npm npx corepack; do
    sudo ln --symbolic --force "${install_dir}/bin/${executable}" \
      "/usr/local/bin/${executable}"
  done
}

expected_node="/opt/node-v${NODE_VERSION}-linux-${NODE_ARCH}/bin/node"
if [[ "$(node --version 2>/dev/null || true)" != "v${NODE_VERSION}" ]] ||
  [[ "$(readlink -f "$(command -v node 2>/dev/null || echo /nonexistent)")" != "$expected_node" ]]; then
  install_node
fi

hash -r
echo "Using $(node --version) and npm $(npm --version)."
echo "Installing dependencies from package-lock.json..."
npm ci

echo "Orb setup complete."
